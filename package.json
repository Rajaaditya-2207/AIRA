{
  "name": "aira",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "dev:app": "next dev -H 127.0.0.1",
    "dev:agent": "tsx src/agent/telephony-agent.ts dev",
    "dev:all": "concurrently -k \"npm:dev:app\" \"npm:dev:agent\"",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx scripts/seed-demo.ts",
    "build:agent": "node scripts/build-agent.cjs",
    "desktop:dev": "concurrently -k \"next dev -p 3057 -H 127.0.0.1\" \"cross-env AIRA_DEV=1 electron .\"",
    "desktop:build": "cross-env AIRA_PACKAGE=1 next build && tsc -p electron/tsconfig.json && node scripts/prepare-desktop.cjs && node scripts/build-agent.cjs && node scripts/swap-native.cjs electron && electron-builder --win",
    "native:node": "node scripts/swap-native.cjs node"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@google/genai": "^1.41.0",
    "@livekit/agents": "^1.0.44",
    "@livekit/agents-plugin-google": "^1.0.44",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "livekit-server-sdk": "^2.15.0",
    "lucide-react": "^0.564.0",
    "next": "16.1.6",
    "p-limit": "^7.3.0",
    "pg": "^8.18.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^38.8.6",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.4.0",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "better-sqlite3@12.11.1": true,
    "electron@38.8.6": true
  },
  "main": "dist-electron/main.js",
  "description": "AIRA - AI phone investigation desktop app"
}
